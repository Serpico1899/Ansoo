# ════════════════════════════════════════════════════════════════
# Ansoo Backend - HTTP E2E Suite
# ════════════════════════════════════════════════════════════════
# Generated by `deno task e2e`; that command drops a dedicated database,
# seeds canonical data, starts the real dispatcher, and supplies login
# assertions through a temporary variables file. Do not run this file against
# a development database.
#
# Manual run against a prepared environment:
#   hurl --test --variables-file <vars.env> http/e2e.hurl
#
# Scope: every currently implemented HTTP action plus auth, capability,
# projection, validation, CORS, health, and rate-limit negatives. There are no
# write actions in the current API, so the suite creates no canonical data over
# HTTP; the runner seeds it deliberately.
# ════════════════════════════════════════════════════════════════

# ----------------------------------------------------------------------------
# Health
# ----------------------------------------------------------------------------
GET {{baseUrl}}/health
HTTP 200
[Asserts]
header "content-type" contains "application/json"
jsonpath "$.status" == "ok"

# ----------------------------------------------------------------------------
# Guest public profile: exact ID, projection allowlist, request id echo
# ----------------------------------------------------------------------------
POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
X-Request-Id: e2e-request-id-1
{
  "service": "main",
  "model": "products",
  "act": "getPublicProfile",
  "details": {
    "set": { "id": "{{productId}}" },
    "get": {
      "researchNotes": true,
      "decidedBy": true,
      "score": true,
      "email": true
    }
  }
}
HTTP 200
[Asserts]
header "content-type" contains "application/json"
header "cache-control" == "no-store"
header "x-request-id" == "e2e-request-id-1"
jsonpath "$.success" == true
jsonpath "$.requestId" == "e2e-request-id-1"
jsonpath "$.body.resolution.state" == "FOUND"
jsonpath "$.body.noUniversalScore" == true
jsonpath "$.body.product.name" == "Acme Soap"
jsonpath "$.body.product.categoryCode" == "household.cleaning.soap"
jsonpath "$.body.brand.name" == "Acme"
jsonpath "$.body.findings" count == 4
jsonpath "$.body.findings[0].findingKind" == "RELATIONSHIP"
jsonpath "$.body.findings[0].scope" == "BRAND"
jsonpath "$.body.findings[0].predicate" == "OWNS"
jsonpath "$.body.findings[0].publicWording" == "Acme Holding owns the Acme brand."
jsonpath "$.body.findings[0].evidence[0].sourceTitle" == "Official Registry"
jsonpath "$.body.findings[0].evidence[0].stance" == "SUPPORTS"
jsonpath "$.body.findings[1].scope" == "ORGANIZATION"
jsonpath "$.body.findings[2].scope" == "BRAND"
jsonpath "$.body.findings[3].scope" == "PRODUCT"
jsonpath "$.body.findings[3].correctionNotice.previousWording" == "The package definitely proves Iranian origin."
jsonpath "$.body.unknowns" count > 0
body not contains "PRIVATE RESEARCH NOTE"
body not contains "assessedBy"
body not contains "decidedBy"
body not contains "sourceSnapshotId"
body not contains "\"score\""
body not contains "\"verdict\""
body not contains "\"badge\""
body not contains "\"rating\""
body not contains "@e2e.example"
body not contains "authSubject"

# ----------------------------------------------------------------------------
# Scan path: leading-zero GTIN and explicit scheme/value
# ----------------------------------------------------------------------------
POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "gtin": "0006381333935" } }
}
HTTP 200
[Asserts]
jsonpath "$.body.resolution.state" == "FOUND"
jsonpath "$.body.resolution.confidence" == "EXACT"
jsonpath "$.body.product.name" == "Acme Soap"
jsonpath "$.body.findings" count == 4

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "scheme": "GTIN", "value": "0006381333935" } }
}
HTTP 200
[Asserts]
jsonpath "$.body.resolution.state" == "FOUND"
jsonpath "$.body.product.name" == "Acme Soap"

# ----------------------------------------------------------------------------
# Honest resolution states: unverified, not found, ambiguous, disputed, merged
# ----------------------------------------------------------------------------
POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "gtin": "00000000000307" } }
}
HTTP 200
[Asserts]
jsonpath "$.body.resolution.state" == "UNVERIFIED"
body contains "UNVERIFIED_IDENTIFIER"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "gtin": "00000000000031" } }
}
HTTP 200
[Asserts]
jsonpath "$.body.resolution.state" == "NOT_FOUND"
jsonpath "$.body.product" not exists
body contains "PRODUCT_NOT_FOUND"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "gtin": "00000000000109" } }
}
HTTP 200
[Asserts]
jsonpath "$.body.resolution.state" == "AMBIGUOUS"
jsonpath "$.body.resolution.candidates" count == 2
jsonpath "$.body.product" not exists
body contains "AMBIGUOUS_IDENTIFIER"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "id": "{{disputedId}}" } }
}
HTTP 200
[Asserts]
jsonpath "$.body.resolution.state" == "DISPUTED"
body contains "UNRESOLVED_DISPUTE"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "id": "{{mergedId}}" } }
}
HTTP 200
[Asserts]
jsonpath "$.body.resolution.state" == "FOUND"
jsonpath "$.body.resolution.productId" == "{{survivorId}}"
jsonpath "$.body.product.name" == "Survivor"
body contains "MERGED_IDENTITY_REDIRECT"

# ----------------------------------------------------------------------------
# Validation negatives: never echo the rejected value
# ----------------------------------------------------------------------------
POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": {} }
}
HTTP 422
[Asserts]
jsonpath "$.success" == false
jsonpath "$.body.error.code" == "VALIDATION_ERROR"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": {
    "set": { "id": "{{productId}}", "gtin": "0006381333935" }
  }
}
HTTP 422
[Asserts]
jsonpath "$.body.error.code" == "VALIDATION_ERROR"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "scheme": "GTIN" } }
}
HTTP 422
[Asserts]
jsonpath "$.body.error.code" == "VALIDATION_ERROR"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "gtin": "not-a-gtin" } }
}
HTTP 422
[Asserts]
jsonpath "$.body.error.code" == "VALIDATION_ERROR"
body not contains "not-a-gtin"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": {
    "set": { "id": "{{productId}}", "$where": "0; drop database" }
  }
}
HTTP 422
[Asserts]
jsonpath "$.body.error.code" == "VALIDATION_ERROR"
body not contains "$where"
body not contains "drop database"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "id": "not-an-object-id" } }
}
HTTP 422
[Asserts]
jsonpath "$.body.error.code" == "VALIDATION_ERROR"
body not contains "not-an-object-id"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
{
  "model": "products",
  "act": "getPublicProfile",
  "details": { "set": { "id": "{{productId}}" }, "unknown": true }
}
HTTP 422
[Asserts]
jsonpath "$.body.error.code" == "VALIDATION_ERROR"

POST {{baseUrl}}/products/getPublicProfile
Content-Type: application/json
"not-json-body"
HTTP 422
[Asserts]
jsonpath "$.body.error.code" == "VALIDATION_ERROR"
body not contains "not-json-body"

POST {{baseUrl}}/products/rawMongoQuery
Content-Type: application/json
{
  "model": "products",
  "act": "rawMongoQuery",
  "details": { "set": {} }
}
HTTP 404
[Asserts]
jsonpath "$.body.error.code" == "NOT_FOUND"
body not contains "getPublicProfile"
body not contains "claims"
body not contains "auditEvents"

GET {{baseUrl}}/products/getPublicProfile
HTTP 405
[Asserts]
jsonpath "$.body.error.code" == "NOT_FOUND"

# ----------------------------------------------------------------------------
# Login through provider assertions
# ----------------------------------------------------------------------------
POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "{{adminAssertion}}" } }
}
HTTP 200
[Captures]
adminToken: jsonpath "$.body.token"
[Asserts]
jsonpath "$.success" == true
jsonpath "$.body.expiresInSeconds" > 0
jsonpath "$.body.user.roles[0]" == "ADMIN"
body not contains "@e2e.example"
body not contains "authSubject"
body not contains "+1555"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "{{contributorAssertion}}" } }
}
HTTP 200
[Captures]
contributorToken: jsonpath "$.body.token"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "{{researcherAssertion}}" } }
}
HTTP 200
[Captures]
researcherToken: jsonpath "$.body.token"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "{{moderatorAssertion}}" } }
}
HTTP 200
[Captures]
moderatorToken: jsonpath "$.body.token"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "{{suspendedAssertion}}" } }
}
HTTP 403
[Asserts]
jsonpath "$.body.error.code" == "FORBIDDEN"
body not contains "@e2e.example"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "not-a-jwt" } }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"
body not contains "not-a-jwt"

# ----------------------------------------------------------------------------
# getMe: safe self projection, guest and token negatives
# ----------------------------------------------------------------------------
POST {{baseUrl}}/users/getMe
Content-Type: application/json
Token: {{adminToken}}
{
  "model": "users",
  "act": "getMe",
  "details": { "set": {}, "get": { "email": true, "authSubject": true } }
}
HTTP 200
[Asserts]
jsonpath "$.body.user.roles[0]" == "ADMIN"
jsonpath "$.body.user.preferredLocale" == "en"
body not contains "@e2e.example"
body not contains "+1555"
body not contains "authSubject"
body not contains "trustLevel"

POST {{baseUrl}}/users/getMe
Content-Type: application/json
{
  "model": "users",
  "act": "getMe",
  "details": { "set": {} }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

POST {{baseUrl}}/users/getMe
Content-Type: application/json
Token: Bearer {{adminToken}}
{
  "model": "users",
  "act": "getMe",
  "details": { "set": {} }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

POST {{baseUrl}}/users/getMe
Content-Type: application/json
Token: not-a-jwt
{
  "model": "users",
  "act": "getMe",
  "details": { "set": {} }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

# ----------------------------------------------------------------------------
# Research claim: capability matrix and RESEARCH projection
# ----------------------------------------------------------------------------
POST {{baseUrl}}/claims/getResearch
Content-Type: application/json
{
  "model": "claims",
  "act": "getResearch",
  "details": { "set": { "id": "{{claimId}}" } }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

POST {{baseUrl}}/claims/getResearch
Content-Type: application/json
Token: {{contributorToken}}
{
  "model": "claims",
  "act": "getResearch",
  "details": { "set": { "id": "{{claimId}}" } }
}
HTTP 403
[Asserts]
jsonpath "$.body.error.code" == "FORBIDDEN"

POST {{baseUrl}}/claims/getResearch
Content-Type: application/json
Token: {{researcherToken}}
{
  "model": "claims",
  "act": "getResearch",
  "details": {
    "set": { "id": "{{claimId}}" },
    "get": { "researchNotes": true, "publicWording": true }
  }
}
HTTP 200
[Asserts]
jsonpath "$.body.claim.researchNotes[0].body" == "PRIVATE RESEARCH NOTE"
jsonpath "$.body.claim.publicWording" == "The package declares an origin of Iran."
jsonpath "$.body.claim.assessment.assessedBy" exists
body not contains "authSubject"
body not contains "@e2e.example"

POST {{baseUrl}}/claims/getResearch
Content-Type: application/json
Token: {{researcherToken}}
{
  "model": "claims",
  "act": "getResearch",
  "details": { "set": { "id": "000000000000000000000999" } }
}
HTTP 404
[Asserts]
jsonpath "$.body.error.code" == "NOT_FOUND"

POST {{baseUrl}}/claims/getResearch
Content-Type: application/json
Token: {{researcherToken}}
{
  "model": "claims",
  "act": "getResearch",
  "details": { "set": { "id": "not-an-object-id" } }
}
HTTP 422
[Asserts]
jsonpath "$.body.error.code" == "VALIDATION_ERROR"
body not contains "not-an-object-id"

# ----------------------------------------------------------------------------
# Audit events: capability matrix, ordering, and limit clamping
# ----------------------------------------------------------------------------
POST {{baseUrl}}/auditEvents/gets
Content-Type: application/json
{
  "model": "auditEvents",
  "act": "gets",
  "details": { "set": { "limit": 2 } }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

POST {{baseUrl}}/auditEvents/gets
Content-Type: application/json
Token: {{researcherToken}}
{
  "model": "auditEvents",
  "act": "gets",
  "details": { "set": { "limit": 2 } }
}
HTTP 403
[Asserts]
jsonpath "$.body.error.code" == "FORBIDDEN"

POST {{baseUrl}}/auditEvents/gets
Content-Type: application/json
Token: {{moderatorToken}}
{
  "model": "auditEvents",
  "act": "gets",
  "details": { "set": { "limit": 2 } }
}
HTTP 200
[Asserts]
jsonpath "$.body.events" count == 2
jsonpath "$.body.events[0].action" == "CORRECTION_APPLIED"
jsonpath "$.body.events[0]._id" == "{{auditRecentId}}"
jsonpath "$.body.events[0].target.id" == "{{claimId}}"
body not contains "@e2e.example"
body not contains "authSubject"
body not contains "@e2e.example"
body not contains "+1555"

POST {{baseUrl}}/auditEvents/gets
Content-Type: application/json
Token: {{moderatorToken}}
{
  "model": "auditEvents",
  "act": "gets",
  "details": { "set": { "limit": 0 } }
}
HTTP 200
[Asserts]
jsonpath "$.body.events" count == 1

# ----------------------------------------------------------------------------
# CORS preflight for the configured browser origin
# ----------------------------------------------------------------------------
OPTIONS {{baseUrl}}/users/login
Origin: http://localhost:3000
Access-Control-Request-Method: POST
HTTP 204
[Asserts]
header "access-control-allow-origin" == "http://localhost:3000"
header "access-control-allow-methods" contains "POST"

# ----------------------------------------------------------------------------
# Login rate limit. Earlier section made 6 login attempts; four more failures
# reach the 10-attempt window and the next one is 429. Keep this last.
# ----------------------------------------------------------------------------
POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "bad-1" } }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "bad-2" } }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "bad-3" } }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "bad-4" } }
}
HTTP 401
[Asserts]
jsonpath "$.body.error.code" == "UNAUTHENTICATED"

POST {{baseUrl}}/users/login
Content-Type: application/json
{
  "model": "users",
  "act": "login",
  "details": { "set": { "providerToken": "bad-5" } }
}
HTTP 429
[Asserts]
header "retry-after" exists
jsonpath "$.body.error.code" == "RATE_LIMITED"
jsonpath "$.body.error.retryAfterSeconds" > 0
