{
  "name": "ansoo-backend",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "tasks": {
    "db:dev": "bash scripts/mongo-dev.sh",
    "dev": "deno run --allow-all --watch mod.ts",
    "start": "deno run --allow-all mod.ts",
    "test": "deno test --allow-all tests/",
    "test:invariants": "deno test --allow-all tests/invariants/",
    "e2e": "deno run --allow-all scripts/run-e2e.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check mod.ts utils/mod.ts scripts/generate-types.ts scripts/check-config.ts scripts/rebuild-public-profiles.ts",
    "config:check": "deno run --allow-env scripts/check-config.ts",
    "types": "deno run --allow-all scripts/generate-types.ts",
    "read-model:rebuild": "deno run --allow-all scripts/rebuild-public-profiles.ts",
    "read-model:repair": "deno run --allow-all scripts/rebuild-public-profiles.ts --repair"
  },
  "fmt": {
    "include": [
      "src/",
      "models/",
      "utils/",
      "scripts/",
      "tests/",
      "mod.ts",
      "taxonomy.v1.json"
    ],
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2,
    "lineWidth": 100
  },
  "lint": {
    "include": ["src/", "models/", "utils/", "scripts/", "tests/", "mod.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "lesan": "jsr:@hemedani/lesan@^0.2.3",
    "djwt": "https://deno.land/x/djwt@v2.8/mod.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@lib": "./utils/mod.ts",
    "@model": "./models/mod.ts"
  },
  "compilerOptions": {
    "strict": true
  }
}
