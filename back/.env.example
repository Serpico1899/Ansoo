# Copy to `.env` and replace every placeholder. The app fails fast when required
# configuration is missing or when JWT_SECRET is a placeholder.
#
# Development uses a single-node MongoDB replica set:
#   deno task db:dev
# which prints the MONGO_URL below. There is no supported standalone topology.

# MongoDB - replicaSet is required outside ENV=test.
MONGO_URL=mongodb://127.0.0.1:27019/?replicaSet=rs0
DB_NAME=ansoo

# Runtime
APP_PORT=1370
ENV=development

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# JWT - must be at least 32 characters and must not be a placeholder.
# Example generator: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN_SECONDS=604800

# Object storage. Asset bytes must never live in MongoDB.
# LOCAL_DEV | S3_COMPATIBLE
ASSET_STORAGE_PROVIDER=LOCAL_DEV
ASSET_LOCAL_ROOT=./uploads
ASSET_MAX_BYTES=20971520

# S3-compatible settings (required when ASSET_STORAGE_PROVIDER=S3_COMPATIBLE)
# ASSET_BUCKET=
# ASSET_REGION=
# ASSET_ENDPOINT=

# Acquisition / SSRF-safe fetcher policy.
# HTTPS only; private, link-local, reserved, loopback, and cloud-metadata ranges
# are blocked and revalidated after redirects and DNS resolution.
# ACQUISITION_PROXY_URL=
ACQUISITION_FETCH_MAX_REDIRECTS=3
ACQUISITION_FETCH_TIMEOUT_MS=10000
ACQUISITION_FETCH_MAX_BYTES=10485760
